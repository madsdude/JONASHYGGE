# HandiHotel Environment Configuration
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
JWT_SECRET=handihotel-super-secret-dev-key-change-in-production

# PostgreSQL (used when Docker / Postgres is running; auto-falls back to local JSON store if unreachable)
DATABASE_URL=postgresql://handihotel:handihotel_secret@localhost:5432/handihotel?schema=public

# Redis (used when Docker / Redis is running; auto-falls back to in-memory adapter if unreachable)
REDIS_URL=redis://localhost:6379

# Force storage mode: "auto" | "postgres" | "local"
STORAGE_MODE=auto

# Stage 1: Build @handihotel/shared and @handihotel/server
FROM node:22-alpine AS builder

WORKDIR /app

# Prisma requires OpenSSL on Alpine
RUN apk add --no-cache openssl

# Copy workspace manifests first for layer caching
COPY package.json package-lock.json* tsconfig.base.json ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/server/package.json ./packages/server/

# Install workspace dependencies
RUN npm install

# Copy source code
COPY packages/shared ./packages/shared
COPY packages/server ./packages/server

# Generate Prisma client
RUN npx prisma generate --schema=packages/server/prisma/schema.prisma

# Build shared library and server
RUN npm run build -w @handihotel/shared && npm run build -w @handihotel/server

# Stage 2: Production runtime
FROM node:22-alpine AS runner

WORKDIR /app

RUN apk add --no-cache openssl

ENV NODE_ENV=production
ENV PORT=4000

COPY --from=builder /app/package.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages/shared/package.json ./packages/shared/
COPY --from=builder /app/packages/shared/dist ./packages/shared/dist
COPY --from=builder /app/packages/server/package.json ./packages/server/
COPY --from=builder /app/packages/server/dist ./packages/server/dist
COPY --from=builder /app/packages/server/prisma ./packages/server/prisma

EXPOSE 4000

# Sync Prisma schema when Postgres is available, then start the server
CMD ["sh", "-c", "npx prisma db push --schema=packages/server/prisma/schema.prisma --skip-generate || true; node packages/server/dist/index.js"]
